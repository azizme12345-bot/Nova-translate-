# GEMINI_API_KEY: Required for backend translation, language detection, and OCR.
# In Google AI Studio, this is automatically injected at runtime from Secrets.
# On Vercel, add this under Project Settings -> Environment Variables.
# NEVER commit your actual API key to GitHub.
GEMINI_API_KEY="your_gemini_api_key_here"

# PORT: The port on which the Express dev / production server listens (defaults to 3000)
PORT="3000"

# APP_URL: Optional canonical URL for production deployments (e.g., https://your-app.vercel.app)
APP_URL="http://localhost:3000"
